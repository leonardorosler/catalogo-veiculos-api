generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"

}

model Tenant {
  id            String   @id @default(cuid())
  nome          String
  slug          String   @unique
  whatsapp      String?
  emailContato  String?
  ativo         Boolean  @default(true)
  plano         Plano    @default(BASICO)
  criadoEm      DateTime @default(now())

  usuarios      Usuario[]
  veiculos      Veiculo[]

  leads         Lead[]
  propostas     Proposta[]
  historicoLeads HistoricoLead[]
  configuracaoComercial ConfiguracaoComercial?
}

enum Plano {
  BASICO
  PROFISSIONAL
  PREMIUM
}

model Usuario {
  id       String @id @default(cuid())
  email    String @unique
  senha    String
  nome     String
  role     Role   @default(VENDEDOR)
  ativo    Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  criadoEm DateTime @default(now())
  leadsResponsavel Lead[]
  historicoLeads HistoricoLead[]

  @@unique([id, tenantId])
}

enum Role {
  ADMIN
  VENDEDOR
}

model Veiculo {
  id          String   @id @default(cuid())
  marca       String
  modelo      String
  ano         Int
  preco       Float
  km          Int
  combustivel Combustivel
  cambio      Cambio
  cor         String
  descricao   String?
  categoria   String?
  opcionais   String[] @default([])
  destaque    Boolean  @default(false)
  vendido     Boolean  @default(false)

  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])

  fotos     Foto[]
  favoritos Favorito[]
  leads     Lead[]
  propostas Proposta[]

  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  @@unique([id, tenantId])
}

enum Combustivel {
  GASOLINA
  ETANOL
  FLEX
  DIESEL
  ELETRICO
  HIBRIDO
}

enum Cambio {
  MANUAL
  AUTOMATICO
  CVT
}

model Foto {
  id        String  @id @default(cuid())
  url       String
  ordem     Int     @default(0)
  capa      Boolean @default(false)

  veiculoId String
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())
}

model Favorito {
  id           String  @id @default(cuid())
  sessionId    String

  veiculoId    String
  veiculo      Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())

  @@unique([sessionId, veiculoId])
}

model Lead {
  id        String   @id @default(cuid())
  tipo      TipoLead
  nome      String
  telefone  String
  email     String?
  dados     Json
  lido      Boolean  @default(false)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @default(now()) @updatedAt
  etapa EtapaLead @default(NOVO)
  origem OrigemLead @default(SITE)
  responsavelId String?
  responsavel Usuario? @relation(fields: [responsavelId, tenantId], references: [id, tenantId], onDelete: Restrict)
  veiculoId String?
  veiculo Veiculo? @relation(fields: [veiculoId, tenantId], references: [id, tenantId], onDelete: Restrict)
  ultimoContatoEm DateTime?
  proximaAtividadeEm DateTime?
  motivoPerda String?
  valorVenda Decimal? @db.Decimal(14, 2)
  fechadoEm DateTime?
  historico HistoricoLead[]
  propostas Proposta[]

  @@unique([id, tenantId])
  @@index([tenantId, responsavelId, etapa])
  @@index([tenantId, criadoEm])
  @@index([tenantId, proximaAtividadeEm])
}

enum TipoLead {
  VENDER_CARRO
  FINANCIAMENTO
  INTERESSE
}

enum EtapaLead {
  NOVO
  CONTATO
  QUALIFICADO
  PROPOSTA
  NEGOCIACAO
  GANHO
  PERDIDO
}

enum OrigemLead {
  SITE
  WHATSAPP
  INDICACAO
  OUTRO
}

enum StatusProposta {
  RASCUNHO
  ENVIADA
  ACEITA
  RECUSADA
}

model HistoricoLead {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  leadId String
  lead Lead @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  autorId String?
  autor Usuario? @relation(fields: [autorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tipo String
  descricao String
  criadoEm DateTime @default(now())

  @@index([tenantId, leadId, criadoEm])
}

model Proposta {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  leadId String
  lead Lead @relation(fields: [leadId, tenantId], references: [id, tenantId])
  veiculoId String
  veiculo Veiculo @relation(fields: [veiculoId, tenantId], references: [id, tenantId])
  numero Int
  status StatusProposta @default(RASCUNHO)
  valor Decimal @db.Decimal(14, 2)
  entrada Decimal? @db.Decimal(14, 2)
  trocaDescricao String?
  trocaValor Decimal? @db.Decimal(14, 2)
  observacoes String?
  validadeEm DateTime
  canal String?
  compartilhadaEm DateTime?
  envioEmailStatus String?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tenantId, numero])
  @@index([tenantId, leadId])
}

model ConfiguracaoComercial {
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id])
  distribuicaoAutomatica Boolean @default(false)
  retornoAutomaticoHoras Int? @default(24)
  diasEstoqueAlerta Int @default(60)
  diasSemContatoAlerta Int @default(2)
  nomeExibicao String?
  corPrimaria String?
  logoUrl String?
  mensagemHero String?
  sequenciaProposta Int @default(0)
  atualizadoEm DateTime @updatedAt
}
